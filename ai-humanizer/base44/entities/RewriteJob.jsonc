{
  "name": "RewriteJob",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "source_text": {
      "type": "string"
    },
    "source_words": {
      "type": "number"
    },
    "style": {
      "type": "string",
      "enum": [
        "professional_researcher",
        "casual_blogger",
        "technical_writer",
        "custom"
      ],
      "default": "professional_researcher"
    },
    "custom_style": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "preserve_headings": {
      "type": "boolean",
      "default": true
    },
    "preserve_lists": {
      "type": "boolean",
      "default": true
    },
    "length_target": {
      "type": "string",
      "enum": [
        "shorter",
        "same",
        "longer"
      ],
      "default": "same"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "needs_review",
        "completed",
        "failed",
        "refused"
      ],
      "default": "queued"
    },
    "stage": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "prompt_version": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model_fast": {
      "type": "string"
    },
    "model_quality": {
      "type": "string"
    },
    "extraction": {
      "type": "object"
    },
    "diagnosis": {
      "type": "object"
    },
    "rewrite_plan": {
      "type": "object"
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rewritten_text": {
      "type": "string"
    },
    "consistency_done": {
      "type": "boolean",
      "default": false
    },
    "consistency_edits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_text": {
      "type": "string"
    },
    "audit": {
      "type": "object"
    },
    "unresolved_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "repair_loops": {
      "type": "number",
      "default": 0
    },
    "input_tokens": {
      "type": "number",
      "default": 0
    },
    "output_tokens": {
      "type": "number",
      "default": 0
    },
    "cost_estimate": {
      "type": "number",
      "default": 0
    },
    "result_words": {
      "type": "number"
    },
    "error": {
      "type": "string"
    },
    "retention_days": {
      "type": "number",
      "default": 30
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "source_text"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}