{
  "name": "UserSetting",
  "type": "object",
  "properties": {
    "retention_days": {
      "type": "number",
      "enum": [
        0,
        7,
        30,
        90
      ],
      "default": 30
    },
    "account_wide_delete_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}